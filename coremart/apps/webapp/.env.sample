# Copy this file to .env.local to use locally.

# These variables are sent to Frontend and publicly visible
NIKKI_PUBLIC_BASE_API_URL=https://cityboi.extapi-local.coremart.local:4433

# Variables for BFF Service, not visible to frontend
NIKKI_BFF_HTTP_PORT=3080
NIKKI_BFF_HTTPS_ENABLED=true
NIKKI_BFF_HTTPS_PORT=3443
NIKKI_BFF_HTTPS_CERTIFICATE_FILE=scripts/frontend-cert/coremart.localhost.crt
NIKKI_BFF_HTTPS_PRIVATE_KEY_FILE=scripts/frontend-cert/coremart.localhost.key
NIKKI_BFF_VITE_HOST=cityboi.coremart.localhost